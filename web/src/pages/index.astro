---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ParticleLogo from '../components/ParticleLogo.astro';
import AutomationCell from '../components/AutomationCell.astro';
import ProcessTabs from '../components/ProcessTabs.astro';
import Isa95 from '../components/Isa95.astro';
import BatchChart from '../components/BatchChart.astro';
import Monogram from '../components/Monogram.astro';
import sitio from '../data/sitio.json';

const empresa = await getEntry('textos', 'empresa');
const reto = await getEntry('textos', 'reto');
const solucion = await getEntry('textos', 'solucion');
const propuesta = await getEntry('textos', 'propuesta');
const aprendizaje = await getEntry('textos', 'aprendizaje');
if (!empresa || !reto || !solucion || !propuesta || !aprendizaje) throw new Error('Falta un texto en src/content/textos');

const { Content: EmpresaTexto } = await render(empresa);
const { Content: RetoTexto } = await render(reto);
const { Content: AprendizajeTexto } = await render(aprendizaje);

const modulos = (await getCollection('modulos')).sort((a, b) => a.data.numero.localeCompare(b.data.numero));
const equipo = await Promise.all(
  (await getCollection('equipo'))
    .sort((a, b) => a.data.numero - b.data.numero)
    .map(async (m) => ({ ...m, Reflexion: (await render(m)).Content, tieneReflexion: Boolean(m.body?.trim()) })),
);

const estados = { pendiente: 'Pendiente', 'en-desarrollo': 'En desarrollo', completado: 'Completado' } as const;
const repoTree = `${sitio.repositorio}/tree/main`;

const kpis = [
  { nombre: 'OEE', unidad: '%', nota: 'Disponibilidad × Desempeño × Calidad' },
  { nombre: 'Takt Time', unidad: 'min/lote', nota: 'Ritmo que exige la demanda' },
  { nombre: 'Throughput', unidad: 'kg/h', nota: 'Producción por hora' },
  { nombre: 'MLT', unidad: 'h', nota: 'Tiempo total de fabricación del lote' },
];
---

<Base>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="hero wrap">
      <ParticleLogo />
      <h1>{sitio.lema}</h1>
      <p class="hero-sub muted">{empresa.data.resumen}</p>
      <div class="hero-links">
        <a class="ghost-link" href="#empresa">Conoce la propuesta <span class="arrow" aria-hidden="true">→</span></a>
        <a class="ghost-link" href={sitio.repositorio} target="_blank" rel="noopener">
          Evidencias en GitHub <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- 01 EMPRESA Y RETO -->
    <section id="empresa" class="section wrap">
      <div class="two-col">
        <div class="section-head">
          <span class="mono">01 · La empresa</span>
          <h2>{empresa.data.titulo}</h2>
          <div class="prose"><EmpresaTexto /></div>
        </div>
        <div class="section-head">
          <span class="mono">02 · El cliente y su reto</span>
          <h2>{reto.data.titulo}</h2>
          <p>{reto.data.resumen}</p>
          <div class="prose"><RetoTexto /></div>
        </div>
      </div>

      <dl class="facts">
        {
          sitio.datos.map((d) => (
            <div class="fact">
              <dt class="fact-value">{d.valor}</dt>
              <dd>
                <span>{d.texto}</span>
                <span class="mono fact-src">{d.fuente}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- 03 AUTOMATIZACIÓN -->
    <section id="automatizacion" class="section wrap">
      <div class="section-head">
        <span class="mono">03 · Automatización</span>
        <h2>Máquinas que trabajan, datos que suben.</h2>
        <p>
          Así se ve una celda de paletizado de la línea de quesos: el sensor detecta la pieza, la banda se detiene,
          el PLC ordena el ciclo y el brazo apila. Cada evento llega al tablero en tiempo real.
        </p>
      </div>
      <AutomationCell />
    </section>

    <!-- 04 PROCESO -->
    <section id="proceso" class="section wrap">
      <div class="section-head">
        <span class="mono">04 · Caracterización del proceso</span>
        <h2>Tres líneas por lotes, una sola planta.</h2>
        <p>
          Operaciones continuas, secuenciales por lotes y discretas conviven en la misma planta. Estas son las etapas y
          variables críticas de cada línea, desde la recepción de la leche hasta el empaque.
        </p>
      </div>
      <ProcessTabs />
    </section>

    <!-- 05 ARQUITECTURA -->
    <section id="arquitectura" class="section wrap">
      <div class="section-head">
        <span class="mono">05 · Solución de Transformación Digital Industrial</span>
        <h2>{solucion.data.titulo}</h2>
        <p>{solucion.data.resumen}</p>
      </div>
      <Isa95 />
    </section>

    <!-- 06 EVIDENCIAS -->
    <section id="evidencias" class="section wrap">
      <div class="section-head">
        <span class="mono">06 · Evidencias y evaluación</span>
        <h2>Datos de proceso, no promesas.</h2>
        <p>
          Cada indicador se publicará con su memoria de cálculo y su simulación. Mientras tanto, mostramos solo lo que
          ya está respaldado por la investigación del equipo.
        </p>
      </div>

      <BatchChart />

      <div class="frame kpis">
        <div class="frame-bar">
          <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="frame-title mono">Indicadores · antes vs. después de la automatización</span>
          <span class="frame-status mono"><span class="pulse" style="background: var(--ash)"></span>Pendiente</span>
        </div>
        <div class="kpi-grid">
          {
            kpis.map((k) => (
              <div class="kpi">
                <span class="mono kpi-label">{k.nombre}</span>
                <span class="kpi-value">
                  —<span class="mono unit">{k.unidad}</span>
                </span>
                <span class="kpi-note">{k.nota}</span>
              </div>
            ))
          }
        </div>
        <p class="frame-foot mono">Se completa con el VSM y la simulación en Tecnomatix · módulo 02</p>
      </div>
    </section>

    <!-- 07 MÓDULOS -->
    <section id="modulos" class="section wrap">
      <div class="section-head">
        <span class="mono">07 · Resultados por módulo</span>
        <h2>El proyecto, módulo por módulo.</h2>
        <p>Cada módulo del curso tiene su carpeta de evidencias en el repositorio.</p>
      </div>
      <div class="cards">
        {
          modulos.map((m) => (
            <article class="card">
              <div class="card-top">
                <span class="mono gold">{m.data.numero}</span>
                <span class="pill" data-estado={m.data.estado}>
                  {estados[m.data.estado]}
                </span>
              </div>
              <h3>{m.data.titulo}</h3>
              <ul class="deliverables">
                {m.data.entregables.map((e) => (
                  <li>{e}</li>
                ))}
              </ul>
              <div class="card-foot">
                <span class="mono card-meta">{m.data.responsables}</span>
                <a class="ghost-link" href={`${repoTree}/${m.data.carpeta}`} target="_blank" rel="noopener">
                  Ver carpeta <span class="arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 08 PROPUESTA -->
    <section id="propuesta" class="section wrap">
      <div class="proposal">
        <Monogram size={96} />
        <div class="section-head">
          <span class="mono">08 · Evaluación técnica y económica</span>
          <h2>{propuesta.data.titulo}</h2>
          <p>{propuesta.data.resumen}</p>
        </div>
      </div>
    </section>

    <!-- 09 EQUIPO -->
    <section id="equipo" class="section wrap">
      <div class="section-head">
        <span class="mono">09 · Equipo y proceso de aprendizaje</span>
        <h2>{aprendizaje.data.titulo}</h2>
        <p>{aprendizaje.data.resumen}</p>
        <div class="prose"><AprendizajeTexto /></div>
      </div>

      <div class="team">
        {
          equipo.map(({ data, Reflexion, tieneReflexion }) => (
            <article class="member">
              <span class="mono gold">{String(data.numero).padStart(2, '0')}</span>
              <h3>{data.nombre}</h3>
              <span class="member-role">{data.rol}</span>
              <div class="member-reflection">
                {tieneReflexion ? <Reflexion /> : <p class="mono pending">Reflexión individual pendiente</p>}
              </div>
              <a class="ghost-link member-gh" href={`https://github.com/${data.github}`} target="_blank" rel="noopener">
                @{data.github} <span class="arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="wrap">
    <div class="footer">
    <div class="footer-brand">
      <Monogram size={28} />
      <span>{sitio.nombre}</span>
    </div>
    <div class="footer-cols">
      <div>
        <span class="mono footer-h">Proyecto</span>
        <p>{sitio.curso}</p>
        <p>{sitio.universidad}</p>
      </div>
      <div>
        <span class="mono footer-h">Enlaces</span>
        <p>
          <a class="ghost-link" href={sitio.repositorio} target="_blank" rel="noopener">
            Repositorio <span class="arrow" aria-hidden="true">→</span>
          </a>
        </p>
        <p>
          {sitio.video ? (
            <a class="ghost-link" href={sitio.video} target="_blank" rel="noopener">
              Video de sustentación <span class="arrow" aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="muted">Video de sustentación · próximamente</span>
          )}
        </p>
      </div>
    </div>
    </div>
  </footer>
</Base>

<style>
  .hero {
    min-height: calc(100dvh - 60px);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 24px;
    padding-top: 32px;
    padding-bottom: 56px;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(34px, 5.4vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.042em;
    max-width: 16ch;
    margin-top: 8px;
  }

  .hero-sub {
    font-size: 16px;
    letter-spacing: -0.2px;
    max-width: 52ch;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 32px;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
  }

  .two-col .section-head {
    margin-bottom: 0;
  }

  .prose {
    display: grid;
    gap: 12px;
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.2px;
    color: var(--cream-70);
    max-width: 60ch;
  }

  .prose :global(p) {
    margin: 0;
  }

  .prose :global(em) {
    color: var(--ash);
  }

  .facts {
    margin: 64px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--cream-12);
  }

  .fact {
    padding: 24px 24px 0 0;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .fact + .fact {
    padding-left: 24px;
    border-left: 1px solid var(--cream-12);
  }

  .fact-value {
    font-size: 28px;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--gold);
  }

  .fact dd {
    margin: 0;
    display: grid;
    gap: 8px;
    color: var(--cream-70);
  }

  .fact-src {
    color: var(--ash);
    font-size: 10px;
  }

  .gold {
    color: var(--gold);
  }

  .kpis {
    margin-top: 24px;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .kpi {
    padding: 20px;
    display: grid;
    gap: 10px;
    border-bottom: 1px solid var(--stroke);
  }

  .kpi + .kpi {
    border-left: 1px solid var(--stroke);
  }

  .kpi-label {
    color: var(--ash);
  }

  .kpi-value {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--cream-40);
  }

  .unit {
    color: var(--gold);
  }

  .kpi-note {
    font-size: 12px;
    color: var(--ash);
  }

  .frame-foot {
    padding: 12px 20px 16px;
    color: var(--ash);
    font-size: 10px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    border: 1px solid var(--cream-16);
    border-radius: var(--radius);
    padding: 28px;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 16px;
    transition: border-color 150ms var(--ease-switch);
  }

  .card:hover {
    border-color: rgb(200 173 134 / 0.6);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card h3 {
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .deliverables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    align-content: start;
    color: var(--cream-70);
  }

  .deliverables li {
    padding-left: 14px;
    position: relative;
  }

  .deliverables li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 5px;
    height: 1px;
    background: var(--gold);
  }

  .card-foot {
    display: grid;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--cream-08);
  }

  .card-meta {
    color: var(--ash);
    font-size: 10px;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .proposal {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 40px;
    align-items: center;
    border: 1px solid var(--cream-12);
    border-radius: var(--radius);
    padding: 40px;
  }

  .proposal .section-head {
    margin: 0;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .member {
    border: 1px solid var(--cream-16);
    border-radius: var(--radius);
    padding: 24px 20px;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 8px;
    transition: border-color 150ms var(--ease-switch);
  }

  .member:hover {
    border-color: rgb(200 173 134 / 0.6);
  }

  .member h3 {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.3px;
    line-height: 1.25;
  }

  .member-role {
    font-size: 12px;
    color: var(--cream-70);
  }

  .member-reflection {
    padding-top: 12px;
    font-size: 13px;
    color: var(--cream-70);
  }

  .pending {
    color: var(--ash);
    font-size: 10px;
  }

  .member-gh {
    font-size: 12px;
    padding-top: 12px;
  }

  .footer {
    margin-top: var(--section-gap);
    padding-top: 56px;
    padding-bottom: 56px;
    border-top: 1px solid var(--cream-08);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.5px;
    align-self: start;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .footer-cols > div {
    display: grid;
    gap: 8px;
    align-content: start;
    color: var(--cream-70);
  }

  .footer-h {
    color: var(--cream);
    margin-bottom: 4px;
  }

  @media (max-width: 1080px) {
    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kpi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kpi:nth-child(3) {
      border-left: 0;
    }
    .footer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .fact + .fact {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--cream-12);
      margin-top: 24px;
    }
    .cards,
    .team {
      grid-template-columns: 1fr;
    }
    .proposal {
      grid-template-columns: 1fr;
      padding: 24px;
      gap: 24px;
    }
    .footer-cols {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .kpi-grid {
      grid-template-columns: 1fr;
    }
    .kpi + .kpi {
      border-left: 0;
    }
  }
</style>
