---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ParticleLogo from '../components/ParticleLogo.astro';
import AutomationCell from '../components/AutomationCell.astro';
import ProcessTabs from '../components/ProcessTabs.astro';
import Isa95 from '../components/Isa95.astro';
import UsoEquipos from '../components/UsoEquipos.astro';
import Monogram from '../components/Monogram.astro';
import Lockup from '../components/Lockup.astro';
import Edt from '../components/Edt.astro';
import Gantt from '../components/Gantt.astro';
import sitio from '../data/sitio.json';

const empresa = await getEntry('textos', 'empresa');
const reto = await getEntry('textos', 'reto');
const solucion = await getEntry('textos', 'solucion');
const propuesta = await getEntry('textos', 'propuesta');
if (!empresa || !reto || !solucion || !propuesta) throw new Error('Falta un texto en src/content/textos');

const { Content: EmpresaTexto } = await render(empresa);
const { Content: RetoTexto } = await render(reto);

const modulos = (await getCollection('modulos')).sort((a, b) => a.data.numero.localeCompare(b.data.numero));
const equipo = (await getCollection('equipo')).sort((a, b) => a.data.numero - b.data.numero);

const estados = { pendiente: 'Pendiente', 'en-desarrollo': 'En desarrollo', completado: 'Completado' } as const;
const repoTree = `${sitio.repositorio}/tree/main`;
// Une las palabras cortas (a, la, de…) con la siguiente para que no queden sueltas al final de una línea.
const sinHuerfanas = (t: string) => t.replace(/\s(\p{L}{1,2})\s/gu, ' $1\u00a0');

// Indicadores de la línea de yogurts, planta actual: simulación de 12 semanas en Tecnomatix y recetas.
const kpis = [
  { nombre: 'OEE', valor: '≈ 70', unidad: '%', nota: 'Llenadoras: 0,90 × 0,80 × 0,97', fuente: 'Diseño · recetas' },
  { nombre: 'Takt Time', valor: '4,2', unidad: 'h/lote', nota: '24 h ÷ 5,75 lotes de 10.000 L', fuente: 'Simulación · Tecnomatix' },
  { nombre: 'Throughput', valor: '≈ 2.350', unidad: 'kg/h', nota: 'Yogurt terminado, 24 h al día', fuente: 'Diseño · recetas' },
  { nombre: 'MLT', valor: '≈ 35', unidad: 'h', nota: 'Lote de fresa, de la recepción a la salida de la cámara', fuente: 'VSM actual' },
];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const blob = `${sitio.repositorio}/blob/main`;
// Galería de la sección de simulación: imagen en public/evidencias y documento completo en el repositorio.
const galeria = [
  { img: 'planta-3d.webp', titulo: 'Planta con tres líneas en Tecnomatix', nota: 'Tronco común de 150.000 L/día, yogurts, quesos y leche UHT, con paletizado manual en las tres líneas. 66 de los 80 objetos de la licencia.', doc: '02_gestion-produccion/simulacion-tecnomatix/planta-150k', tipo: 'Modelo 3D', ancho: true },
  { img: 'planta-vsm.webp', titulo: 'VSM de la planta', nota: 'Un VSM por línea sobre el tronco común, con el uso de cada equipo simulado.', doc: '02_gestion-produccion/vsm/vsm_planta_3_lineas_clasico.pdf', tipo: 'VSM' },
  { img: 'planta-layout.webp', titulo: 'Distribución de la planta', nota: 'Plano de la nave de 110 × 60 m: muros, puertas, pasillos y 80 % de piso libre.', doc: '02_gestion-produccion/distribucion-planta/layout_planta_3_lineas_clasico.pdf', tipo: 'Layout' },
  { img: 'yogur-3d-manual.webp', titulo: 'Línea de yogurts con paletizado manual', nota: 'Escenario actual: dos personas estiban las cajas que llegan por las bandas.', doc: '02_gestion-produccion/simulacion-tecnomatix/linea-yogures', tipo: 'Modelo 3D', ancho: true },
  { img: 'yogur-vsm.webp', titulo: 'VSM de la línea de yogurts', nota: 'Lead time ≈ 35 h con 30 % de valor agregado. La llenadora de vasos marca el ritmo.', doc: '02_gestion-produccion/vsm/vsm_linea_yogures_clasico.pdf', tipo: 'VSM', ancho: true },
  { img: 'espagueti-actual.webp', titulo: 'Diagrama de espagueti de la línea de yogurts', nota: '≈ 21 km de recorridos al día y ≈ 11.600 cajas estibadas a mano. La ruta morada es la de la analista de calidad.', doc: '02_gestion-produccion/distribucion-planta/espagueti_linea_yogures_actual_clasico.pdf', tipo: 'Espagueti', ancho: true },
];
const recetas = [
  { titulo: 'Recetas y procesos de la planta', nota: 'Yogurts, quesos y leche UHT: fórmulas, procedimientos, parámetros y PCC', doc: '01_transformacion-digital/isa88/Recetas_y_procesos_planta.pdf' },
];
---

<Base>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="hero wrap">
      <div class="stack-strip" role="region" aria-label="Tecnologías y estándares del proyecto">
        <div class="stack-track">
          {
            [...sitio.tecnologias, ...sitio.tecnologias].map((t, i) => (
              <span class="mono stack-item" aria-hidden={i >= sitio.tecnologias.length ? 'true' : undefined}>
                {t}
              </span>
            ))
          }
        </div>
      </div>

      <div class="hero-main">
        <h1>{sinHuerfanas(sitio.lema)}</h1>
        <ParticleLogo />
      </div>
    </section>

    <!-- 01 EMPRESA Y RETO -->
    <section id="empresa" class="section wrap">
      <div class="two-col">
        <div class="section-head">
          <span class="mono">01 · La empresa</span>
          <h2>{empresa.data.titulo}</h2>
          <p>{empresa.data.resumen}</p>
          <div class="prose"><EmpresaTexto /></div>
        </div>
        <div class="section-head">
          <span class="mono">02 · El cliente</span>
          <h2>{reto.data.titulo}</h2>
          <p>{reto.data.resumen}</p>
          <div class="prose"><RetoTexto /></div>
        </div>
      </div>

      <dl class="facts">
        {
          sitio.datos.map((d) => (
            <div class="fact">
              <dt class="fact-value">{d.valor}</dt>
              <dd>
                <span>{d.texto}</span>
                <span class="mono fact-src">{d.fuente}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- 03 AUTOMATIZACIÓN -->
    <section id="automatizacion" class="section wrap">
      <div class="section-head">
        <span class="mono">03 · Automatización</span>
        <h2>Máquinas que trabajan, datos que suben.</h2>
        <p>
          Así se verá la celda de paletizado de la línea de yogurts: el sensor detecta la caja, la banda se detiene,
          el PLC ordena el ciclo y el brazo apila. Hoy lo hacen dos personas a mano; con la celda, cada evento llega al
          tablero en tiempo real.
        </p>
      </div>
      <AutomationCell />
    </section>

    <!-- 04 PROCESO -->
    <section id="proceso" class="section wrap">
      <div class="section-head">
        <span class="mono">04 · Proceso</span>
        <h2>Tres líneas. Una sola planta.</h2>
        <p>
          Operaciones continuas, secuenciales por lotes y discretas conviven en la misma planta. Estas son las etapas y
          variables críticas de cada línea, desde la recepción de la leche hasta el empaque.
        </p>
      </div>
      <ProcessTabs />
    </section>

    <!-- 05 ARQUITECTURA -->
    <section id="arquitectura" class="section wrap">
      <div class="section-head">
        <span class="mono">05 · Arquitectura</span>
        <h2>{solucion.data.titulo}</h2>
        <p>{solucion.data.resumen}</p>
      </div>
      <Isa95 />
    </section>

    <!-- 06 EVIDENCIAS -->
    <section id="evidencias" class="section wrap">
      <div class="section-head">
        <span class="mono">06 · Evidencias</span>
        <h2>Datos de proceso, no promesas.</h2>
        <p>
          Indicadores de la línea de yogurts en la planta actual, con su memoria de cálculo en las recetas y en la
          simulación de 12 semanas en Tecnomatix. Son valores de diseño y de simulación, no medidas de planta.
        </p>
      </div>

      <UsoEquipos>
        <div class="kpi-grid">
          {
            kpis.map((k) => (
              <div class="kpi">
                <span class="mono kpi-label">{k.nombre}</span>
                <span class="kpi-value">
                  {k.valor}<span class="mono unit">{k.unidad}</span>
                </span>
                <span class="kpi-note">{k.nota}</span>
                <span class="mono kpi-pending">{k.fuente}</span>
              </div>
            ))
          }
        </div>
      </UsoEquipos>
    </section>

    <!-- 07 SIMULACIÓN -->
    <section id="simulacion" class="section wrap">
      <div class="section-head">
        <span class="mono">07 · Simulación y planta</span>
        <h2>La planta, modelada antes de tocarla.</h2>
        <p>
          Modelos de Plant Simulation, VSM, distribución en planta y diagramas de espagueti de la planta de 150.000 L/día
          y de la línea de yogurts. Abre cada uno para verlo en grande y descargar el documento completo.
        </p>
      </div>
      <ol class="fichas">
        {
          galeria.map((g, i) => (
            <li>
              <button type="button" class="ficha" data-visor data-img={`${base}evidencias/${g.img}`} data-titulo={g.titulo}
                data-nota={g.nota} data-doc={`${g.doc.endsWith('.pdf') ? blob : repoTree}/${g.doc}`}>
                <span class="ficha-n mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="ficha-tipo mono gold">{g.tipo}</span>
                <span class="ficha-t">{g.titulo}</span>
                <span class="ficha-nota">{g.nota}</span>
                <span class="ficha-ver mono" aria-hidden="true">Ver ↗</span>
              </button>
            </li>
          ))
        }
      </ol>
      <dialog class="visor" aria-label="Imagen ampliada">
        <div class="visor-bar">
          <strong data-visor-titulo></strong>
          <a class="visor-doc mono" data-visor-doc target="_blank" rel="noopener">Ver documento →</a>
          <button type="button" class="visor-x" data-visor-cerrar aria-label="Cerrar">×</button>
        </div>
        <div class="visor-body"><img data-visor-img alt="" /></div>
        <p class="visor-nota" data-visor-nota></p>
      </dialog>
      <script>
        const visor = document.querySelector<HTMLDialogElement>('dialog.visor');
        if (visor) {
          const img = visor.querySelector<HTMLImageElement>('[data-visor-img]')!;
          document.querySelectorAll<HTMLButtonElement>('[data-visor]').forEach((b) =>
            b.addEventListener('click', () => {
              img.src = b.dataset.img!;
              img.alt = `${b.dataset.titulo}. ${b.dataset.nota}`;
              visor.querySelector('[data-visor-titulo]')!.textContent = b.dataset.titulo!;
              visor.querySelector('[data-visor-nota]')!.textContent = b.dataset.nota!;
              visor.querySelector<HTMLAnchorElement>('[data-visor-doc]')!.href = b.dataset.doc!;
              visor.showModal();
            }),
          );
          visor.querySelector('[data-visor-cerrar]')!.addEventListener('click', () => visor.close());
          visor.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });
        }
      </script>
      <div class="docs">
        {
          recetas.map((r) => (
            <a class="doc" href={`${blob}/${r.doc}`} target="_blank" rel="noopener">
              <span class="mono gold">PDF</span>
              <span class="doc-t">{r.titulo}</span>
              <span class="doc-n">{r.nota}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 08 PLANEACIÓN -->
    <section id="planeacion" class="section wrap">
      <div class="section-head">
        <span class="mono">08 · Planeación</span>
        <h2>Doce meses, de la ingeniería a la operación.</h2>
        <p>El semestre es la primera fase de un proyecto de doce meses: después de la propuesta vienen las compras, el montaje, dos paradas breves de planta y la puesta en marcha de la línea de yogurts con su MES.</p>
      </div>

      <div class="plan-block">
        <div class="plan-head">
          <h3>Estructura de desglose del trabajo</h3>
          <a class="ghost-link" href="https://github.com/Mekvra/proyecto-integrador/blob/main/03_planeacion-proyecto/edt-cronograma/EDT_Completo_v1.0.pdf" target="_blank" rel="noopener">Ver PDF <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <Edt />
      </div>

      <div class="plan-block">
        <div class="plan-head">
          <h3>Cronograma</h3>
          <a class="ghost-link" href="https://github.com/Mekvra/proyecto-integrador/blob/main/03_planeacion-proyecto/edt-cronograma/Cronograma_Planta_Lactea_v1.0.pdf" target="_blank" rel="noopener">Ver PDF <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <Gantt />
      </div>
    </section>

    <!-- 09 MÓDULOS -->
    <section id="modulos" class="section wrap">
      <div class="section-head">
        <span class="mono">09 · Módulos</span>
        <h2>Cada entregable, en su lugar.</h2>
        <p>Cada módulo del curso tiene su carpeta de evidencias en el repositorio.</p>
      </div>
      <div class="cards">
        {
          modulos.map((m) => (
            <article class="card">
              <div class="card-top">
                <span class="mono gold">{m.data.numero}</span>
                <span class="pill" data-estado={m.data.estado}>
                  {estados[m.data.estado]}
                </span>
              </div>
              <h3>{m.data.titulo}</h3>
              <ul class="deliverables">
                {m.data.entregables.map((e) => (
                  <li>{e}</li>
                ))}
              </ul>
              <div class="card-foot">
                <a class="ghost-link" href={`${repoTree}/${m.data.carpeta}`} target="_blank" rel="noopener">
                  Ver carpeta <span class="arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 10 PROPUESTA -->
    <section id="propuesta" class="section wrap">
      <div class="proposal">
        <Monogram size={96} />
        <div class="section-head">
          <span class="mono">10 · Propuesta de valor</span>
          <h2>{propuesta.data.titulo}</h2>
          <p>{propuesta.data.resumen}</p>
        </div>
      </div>
    </section>

    <!-- 11 EQUIPO -->
    <section id="equipo" class="section wrap">
      <div class="section-head">
        <span class="mono">11 · Equipo</span>
        <h2>Las personas detrás de Mekvra.</h2>
        <p>Cinco ingenieros mecatrónicos a cargo de la automatización, la ingeniería, la gestión, las finanzas y el software del proyecto.</p>
      </div>

      <div class="team">
        {
          equipo.map(({ data }) => (
            <article class="member">
              <span class="mono gold">{String(data.numero).padStart(2, '0')}</span>
              <h3>{data.nombre}</h3>
              <span class="member-role">{data.rol}</span>
              <a class="ghost-link member-gh" href={`https://github.com/${data.github}`} target="_blank" rel="noopener">
                @{data.github} <span class="arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="wrap">
    <div class="footer">
    <div class="footer-brand">
      <Lockup size="lg" />
    </div>
    <div class="footer-cols">
      <div>
        <span class="mono footer-h">Proyecto</span>
        <p>Proyecto Integrador · APM 2026-2S</p>
        <p>{sitio.curso}</p>
        <p>{sitio.universidad}</p>
      </div>
      <div>
        <span class="mono footer-h">Enlaces</span>
        <p>
          <a class="ghost-link" href={sitio.repositorio} target="_blank" rel="noopener">
            Repositorio <span class="arrow" aria-hidden="true">→</span>
          </a>
        </p>
        {sitio.video && (
          <p>
            <a class="ghost-link" href={sitio.video} target="_blank" rel="noopener">
              Video de sustentación <span class="arrow" aria-hidden="true">→</span>
            </a>
          </p>
        )}
      </div>
    </div>
    </div>
  </footer>
</Base>

<style>
  /* Inicio sereno (referencia: Balsa): píldora, titular condensado, texto breve y
     el logo de partículas como pieza central debajo. */
  .hero {
    min-height: calc(100svh - 61px);
    display: grid;
    grid-template-rows: auto 1fr;
    padding-bottom: clamp(24px, 4svh, 40px);
    text-align: center;
  }

  /* Franja de tecnologías: se desplaza lento, como la banda de logos de Factory. */
  .stack-strip {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--cream-08);
    border-bottom: 1px solid var(--cream-08);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .stack-track {
    display: flex;
    width: max-content;
    animation: stack-scroll 48s linear infinite;
  }

  .stack-item {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 14px 0 14px 28px;
    color: var(--granite);
    white-space: nowrap;
  }

  .stack-item::after {
    content: '';
    width: 4px;
    height: 4px;
    background: var(--gold);
    opacity: 0.8;
  }

  @keyframes stack-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-track {
      animation: none;
    }
  }

  .hero-main {
    display: grid;
    align-content: center;
    justify-items: center;
    padding-top: clamp(28px, 5svh, 56px);
  }

  .hero h1 {
    font-family: var(--font-display), 'Arial Narrow', sans-serif;
    font-weight: 600;
    font-size: clamp(34px, min(5vw, 7svh), 60px);
    line-height: 0.95;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .hero-sub {
    margin-top: clamp(14px, 2.4svh, 22px);
    font-size: 14px;
    line-height: 1.55;
    color: var(--cream-70);
    max-width: 46ch;
  }

  .hero :global(.plogo) {
    margin-top: clamp(24px, 4.5svh, 48px);
    width: min(420px, 80vw, 42svh);
  }

  @media (max-width: 560px) {
    .hero :global(.plogo) {
      width: min(92vw, 44svh);
    }
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
  }

  .two-col .section-head {
    margin-bottom: 0;
  }

  .prose {
    display: grid;
    gap: 12px;
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.2px;
    color: var(--cream-70);
    max-width: 60ch;
  }

  .prose :global(p) {
    margin: 0;
  }

  .prose :global(em) {
    color: var(--granite);
  }

  .facts {
    margin: 64px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--cream-12);
  }

  .fact {
    padding: 24px 24px 0 0;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .fact + .fact {
    padding-left: 24px;
    border-left: 1px solid var(--cream-12);
  }

  .fact-value {
    font-size: 28px;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--gold);
  }

  .fact dd {
    margin: 0;
    display: grid;
    gap: 8px;
    color: var(--cream-70);
  }

  .fact-src {
    color: var(--granite);
    font-size: 11px;
  }

  .gold {
    color: var(--gold);
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .kpi {
    padding: 16px 20px;
    display: grid;
    gap: 8px;
    border-bottom: 1px solid var(--stroke);
  }

  .kpi-pending {
    color: var(--granite);
    font-size: 11px;
  }

  .kpi + .kpi {
    border-left: 1px solid var(--stroke);
  }

  .kpi-label {
    color: var(--granite);
  }

  .kpi-value {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--granite);
  }

  .unit {
    color: var(--gold);
  }

  .kpi-note {
    font-size: 12px;
    color: var(--granite);
  }

  .kpi .kpi-value {
    color: var(--cream);
  }

  /* Galería de simulación: capturas en marco fino, como pantallas de instrumento. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .shot {
    margin: 0;
    border: 1px solid var(--cream-16);
    border-radius: var(--radius-frame);
    overflow: hidden;
    background: var(--carbon);
    display: grid;
    grid-template-rows: auto 1fr;
    transition: border-color 150ms var(--ease-switch);
  }

  .shot:hover {
    border-color: var(--gold-60);
  }

  .shot.wide {
    grid-column: 1 / -1;
  }

  /* cada documento es una lámina sobre la mesa: papel con margen y sombra; clic = visor ampliado */
  .shot-link {
    position: relative;
    display: block;
    width: 100%;
    padding: clamp(14px, 3vw, 28px);
    border: 0;
    background: radial-gradient(120% 90% at 50% 0%, #1d1b19 0%, var(--carbon) 70%);
    cursor: zoom-in;
  }

  .sheet {
    display: block;
    border-radius: 3px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 0 rgb(255 247 221 / 0.08), 0 18px 40px -18px rgb(0 0 0 / 0.9);
    transition: transform 300ms var(--ease-out-expo);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-link:hover .sheet,
  .shot-link:focus-visible .sheet {
    transform: scale(1.012);
  }

  .zoom {
    position: absolute;
    right: 16px;
    bottom: 12px;
