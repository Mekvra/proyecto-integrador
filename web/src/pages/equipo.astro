---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Siguiente from '../components/Siguiente.astro';
import sitio from '../data/sitio.json';
import { getCollection } from 'astro:content';

const equipo = (await getCollection('equipo')).sort((a, b) => a.data.numero - b.data.numero);
const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
// Nombre + primer apellido (con cuatro palabras, el primer apellido es la penúltima).
const iniciales = (n: string) => {
  const p = n.split(' ').filter((x) => x && !['de', 'del', 'la'].includes(x.toLowerCase()));
  return p[0][0] + (p.length >= 4 ? p[p.length - 2] : p[p.length - 1])[0];
};
---

<Base title={`Equipo · ${sitio.nombre}`}>
  <Nav actual="equipo" />

  <main class="pagina">
    <!-- 11 EQUIPO -->
    <section id="equipo" class="section wrap">
      <div class="section-head">
        <span class="mono">11 · Equipo</span>
        <h2>Las personas detrás de Mekvra.</h2>
        <p>
          Cinco ingenieros mecatrónicos a cargo de la automatización, la ingeniería, la gestión, las finanzas y el
          software del proyecto.
        </p>
      </div>

      <ul class="team">
        {
          equipo.map(({ data }, i) => (
            <li class="member" style={`--i:${i}`}>
              <article class="persona">
                <span class="top mono">
                  <span class="gold">{String(data.numero).padStart(2, '0')}</span>
                  <span class="sigla">{data.sigla}</span>
                </span>
                <span class="retrato" aria-hidden="true">
                  <span class="aro" />
                  {data.foto ? (
                    <img src={`${BASE}equipo/${data.foto}`} alt="" loading="lazy" width="240" height="240" />
                  ) : (
                    <span class="ini">{iniciales(data.nombre)}</span>
                  )}
                </span>
                <h3 class="nombre">{data.nombre}</h3>
                <span class="member-role">{data.rol}</span>
                <ul class="tareas">
                  {data.tareas.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                <a class="gh mono" href={`https://github.com/${data.github}`} target="_blank" rel="noopener">
                  @{data.github} <span class="arrow" aria-hidden="true">→</span>
                </a>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="team-nota mono">Responsabilidades según la matriz RACI del proyecto (responsable o aprobador).</p>
    </section>
    <Siguiente actual="equipo" />
  </main>

  <Footer />
</Base>

<style>
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .member {
    padding: 0;
    border: 0;
  }

  .persona {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 18px;
    border: 1px solid var(--cream-16);
    border-radius: var(--radius-frame);
    background: var(--carbon);
    transition:
      border-color 200ms var(--ease-switch),
      translate 400ms var(--ease-out-expo),
      box-shadow 400ms var(--ease-out-expo);
  }

  .persona:hover {
    translate: 0 -6px;
    border-color: var(--gold-60);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55);
  }

  .top {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--granite);
  }

  .sigla {
    padding: 1px 7px;
    border: 1px solid var(--cream-12);
    border-radius: 99px;
    letter-spacing: 0.6px;
  }

  .retrato {
    position: relative;
    display: grid;
    place-items: center;
    width: 120px;
    aspect-ratio: 1;
    margin: 14px auto 8px;
  }

  .aro {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: conic-gradient(from var(--giro, 0deg), var(--gold), transparent 30%, var(--gold-60) 55%, transparent 80%, var(--gold));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    opacity: 0.55;
    transition: opacity 300ms var(--ease-switch);
  }

  .persona:hover .aro {
    opacity: 1;
    animation: girar 4s linear infinite;
  }

  @property --giro {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes girar {
    to {
      --giro: 360deg;
    }
  }

  .retrato img,
  .ini {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .ini {
    display: grid;
    place-items: center;
    background: var(--black);
    border: 1px solid var(--cream-12);
    color: var(--gold);
    font-size: 40px;
    font-weight: 600;
  }

  .nombre {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.3px;
    line-height: 1.25;
    text-align: center;
  }

  .member-role {
    font-size: 12.5px;
    color: var(--gold);
    text-align: center;
  }

  .tareas {
    list-style: none;
    margin: 10px 0 0;
    padding: 12px 0 0;
    display: grid;
    gap: 7px;
    border-top: 1px solid var(--cream-08);
  }

  .tareas li {
    position: relative;
    padding-left: 13px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--cream-70);
  }

  .tareas li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--gold);
  }

  .gh {
    margin-top: auto;
    padding-top: 12px;
    font-size: 11px;
    color: var(--granite);
  }

  .gh:hover {
    color: var(--gold);
  }

  .team-nota {
    margin-top: 20px;
    font-size: 11px;
    color: var(--granite);
  }

  @media (max-width: 1100px) {
    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .team {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .persona:hover {
      translate: none;
    }
    .persona:hover .aro {
      animation: none;
    }
  }
</style>
