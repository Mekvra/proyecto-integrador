---
// MES de Lácteos Altos de Teusacá: inicio de sesión real, planta en vivo y vistas por rol (Supabase).
// Conexión: src/data/mes.json. Base de datos: 02_gestion-produccion/mes-erp/supabase/ (esquema.sql y esquema-2-planta.sql).
// La lógica está en src/scripts/mes.ts.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import sitio from '../data/sitio.json';
import mes from '../data/mes.json';

const conectado = Boolean(mes.url && mes.anonKey);
---

<Base title={`MES · ${sitio.nombre}`}>
  <Nav actual="mes" />

  <main class="mes" data-mes data-url={mes.url} data-key={mes.anonKey}>
    <!-- ingreso -->
    <section class="section wrap mes-portada" data-vista="login">
      <div class="portada-txt">
        <span class="mono">10 · MES</span>
        <h2>La planta, en un solo tablero.</h2>
        <p>
          Plataforma de ejecución de la manufactura de Lácteos Altos de Teusacá. Cada persona entra con su usuario desde
          cualquier portátil y ve lo que le toca: el operario su máquina y su turno, calidad los lotes por liberar,
          mantenimiento las fallas, el jefe de planta y la gerencia los indicadores. Todo en tiempo real.
        </p>
        <ul class="portada-roles mono">
          <li>Operario</li><li>Supervisor</li><li>Calidad</li><li>Mantenimiento</li><li>Jefe de planta</li><li>Gerencia</li>
        </ul>
      </div>
      <div class="frame mes-login">
        <div class="frame-bar">
          <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="frame-title mono">Lácteos Altos de Teusacá · MES</span>
          <span class="frame-status mono"><span class="pulse" data-live={conectado ? '' : undefined}></span>{conectado ? 'En línea' : 'Sin servidor'}</span>
        </div>
        <form class="login" data-login>
          <h3>Iniciar sesión</h3>
          <label class="campo">
            <span class="mono">Correo</span>
            <input type="email" name="correo" autocomplete="username" required />
          </label>
          <label class="campo">
            <span class="mono">Contraseña</span>
            <input type="password" name="clave" autocomplete="current-password" required minlength="6" />
          </label>
          <button class="m-btn" type="submit" disabled={!conectado}>Entrar</button>
          <p class="login-msg" data-login-msg role="status">
            {conectado ? 'Los usuarios los crea el administrador de la planta.' : 'El MES todavía no está conectado a su servidor.'}
          </p>
        </form>
      </div>
    </section>

    <!-- plataforma -->
    <div class="mes-app" data-vista="app" hidden>
      <aside class="mes-side">
        <div class="side-marca">
          <span class="mono gold">LAT · MES</span>
          <b>Lácteos Altos de Teusacá</b>
          <span class="mono">Planta 150.000 L/día</span>
        </div>
        <nav class="side-menu" data-menu aria-label="Ventanas del MES"></nav>
        <div class="side-pie">
          <label class="campo como" data-como hidden>
            <span class="mono">Ver como</span>
            <select></select>
          </label>
          <div class="usuario">
            <span class="avatar" data-u-ini aria-hidden="true"></span>
            <span><b data-u-nombre></b><small class="mono" data-u-rol></small></span>
          </div>
          <button class="m-btn sec mini" type="button" data-salir>Cerrar sesión</button>
        </div>
      </aside>

      <div class="mes-main">
        <header class="mes-top">
          <div>
            <span class="mono gold" data-grupo></span>
            <h1 data-titulo>MES</h1>
          </div>
          <div class="top-estado mono">
            <span data-turno></span>
            <span data-reloj></span>
            <span class="en-vivo"><span class="pulse" data-live></span><span data-live-t>Conectando…</span></span>
          </div>
        </header>
        <p class="aviso" data-aviso role="status" hidden></p>
        <div class="mes-cont" data-cont></div>
      </div>
    </div>

    <dialog class="m-dialog" data-dialogo></dialog>
  </main>
</Base>

<script>
  import '../scripts/mes.ts';
</script>

<style is:global>
  /* ============ MES · extiende web/DESIGN.md (mismos tokens; colores de estado de máquina propios) ============ */
  .mes {
    --est-marcha: var(--green);
    --est-parada: var(--granite);
    --est-cambio: var(--gold);
    --est-limpieza: #7fa9c9;
    --est-falla: var(--orange);
    --est-mant: #b691d2;
  }
  :root[data-theme='light'] .mes {
    --est-limpieza: #2f6c97;
    --est-mant: #7b4b9c;
  }
  .e-marcha { --c: var(--est-marcha); }
  .e-parada { --c: var(--est-parada); }
  .e-cambio { --c: var(--est-cambio); }
  .e-limpieza { --c: var(--est-limpieza); }
  .e-falla { --c: var(--est-falla); }
  .e-mant { --c: var(--est-mant); }
  .o-planeada { --c: var(--granite); }
  .o-liberada { --c: var(--est-limpieza); }
  .o-enejecucin { --c: var(--est-marcha); }
  .o-terminada { --c: var(--gold); }
  .o-cerrada { --c: var(--cream-40); }
  .l-enproceso, .l-enrevisin { --c: var(--est-limpieza); }
  .l-terminado { --c: var(--gold); }
  .l-liberado, .l-aprobado { --c: var(--est-marcha); }
  .l-retenido, .l-rechazado { --c: var(--est-falla); }
  .p-alta { --c: var(--gold); }
  .p-urgente { --c: var(--orange); }

  /* ---------- portada e ingreso ---------- */
  .mes-portada {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-top: clamp(40px, 7vw, 88px);
  }
  .mes-portada::before { display: none; }
  .portada-txt { display: grid; gap: 16px; align-content: start; }
  .portada-txt > .mono { color: var(--gold); }
  .portada-txt p { color: var(--cream-70); max-width: 56ch; }
  .portada-roles { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 8px 0 0; }
  .portada-roles li { padding: 4px 10px; border: 1px solid var(--cream-12); border-radius: 99px; color: var(--cream-70); font-size: 11px; }
  .mes-login { width: 100%; max-width: 440px; justify-self: end; }
  .login { display: grid; gap: 16px; padding: 28px 24px 24px; }
  .login h3 { font-size: 20px; font-weight: 500; letter-spacing: -0.5px; }
  .login .m-btn { min-height: 44px; }
  .login-msg { color: var(--granite); font-size: 13px; min-height: 1.4em; }

  /* ---------- controles ---------- */
  .mes .campo { display: grid; gap: 6px; min-width: 0; }
  .mes .campo > .mono { color: var(--granite); font-size: 11px; letter-spacing: 0.4px; text-transform: uppercase; }
  .mes input, .mes select {
    width: 100%;
    min-height: 40px;
    padding: 8px 10px;
    border: 1px solid var(--cream-16);
    border-radius: var(--radius);
    background: var(--black);
    color: var(--cream);
    font: inherit;
    font-size: 14px;
  }
  .mes input:focus-visible, .mes select:focus-visible { outline: 1px solid var(--gold); border-color: var(--gold); }
  .m-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--gold);
    border-radius: var(--radius);
    background: var(--gold);
    color: var(--black);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 150ms var(--ease-switch), color 150ms var(--ease-switch), border-color 150ms var(--ease-switch);
  }
  .m-btn:hover { background: var(--cream); border-color: var(--cream); }
  .m-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .m-btn.sec { background: transparent; color: var(--cream); border-color: var(--cream-16); }
  .m-btn.sec:hover { border-color: var(--gold); color: var(--gold); }
  .m-btn.mini { min-height: 30px; padding: 4px 10px; font-size: 12px; }
  .m-btn.peligro { background: transparent; color: var(--granite); border-color: transparent; }
  .m-btn.peligro:hover { color: var(--orange); border-color: var(--orange); }
  .m-form { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; align-items: end; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 9px 2px 7px;
    border: 1px solid color-mix(in srgb, var(--c, var(--granite)) 45%, transparent);
    border-radius: 99px;
    background: color-mix(in srgb, var(--c, var(--granite)) 12%, transparent);
    color: var(--c, var(--cream-70));
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    white-space: nowrap;
    vertical-align: middle;
  }
  .chip::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .e-falla.chip::before { animation: mes-latido 1.2s ease-in-out infinite; }
  .mes .gold { color: var(--gold); }
  .mes .sub { color: var(--granite); font-size: 12px; }
  .mes .nota { color: var(--granite); font-size: 12px; line-height: 1.5; }
  .mes .vacio { color: var(--granite); font-size: 13px; padding: 12px 0; }

  /* ---------- armazón de la plataforma ---------- */
  .mes-app {
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
    min-height: calc(100vh - 61px);
    border-top: 1px solid var(--cream-08);
  }
  .mes-app[hidden] { display: none; }
  .mes-side {
    position: sticky;
    top: var(--nav-offset, 0px);
    align-self: start;
    height: calc(100vh - var(--nav-offset, 0px));
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px 14px 16px;
    border-right: 1px solid var(--cream-08);
    background: var(--carbon);
    overflow-y: auto;
    transition: top 320ms var(--ease-out-expo), height 320ms var(--ease-out-expo);
  }
  .side-marca { display: grid; gap: 2px; padding: 0 8px 16px; border-bottom: 1px solid var(--cream-08); }
  .side-marca b { font-size: 14px; font-weight: 500; }
  .side-marca .mono { font-size: 11px; color: var(--granite); }
  .side-marca .gold { color: var(--gold); }
  .side-menu { display: grid; gap: 18px; }
  .side-menu .grupo { display: grid; gap: 2px; }
  .side-menu .grupo > .mono { padding: 0 8px 6px; color: var(--granite); font-size: 10px; letter-spacing: 0.8px; text-transform: uppercase; }
  .side-menu a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius);
    color: var(--cream-70);
    font-size: 14px;
    transition: background-color 150ms var(--ease-switch), color 150ms var(--ease-switch);
  }
  .side-menu a:hover { background: var(--cream-08); color: var(--cream); }
  .side-menu a[aria-current] { background: var(--cream-08); color: var(--cream); }
  .side-menu a[aria-current]::before { content: ''; position: absolute; left: -14px; top: 8px; bottom: 8px; width: 2px; background: var(--gold); }
  .side-menu svg { width: 17px; height: 17px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .side-menu a[aria-current] svg { color: var(--gold); }
  .side-pie { margin-top: auto; display: grid; gap: 12px; padding-top: 16px; border-top: 1px solid var(--cream-08); }
  .side-pie .como[hidden] { display: none; }
  .usuario { display: flex; align-items: center; gap: 10px; padding: 0 4px; min-width: 0; }
  .usuario > span:last-child { display: grid; min-width: 0; }
  .usuario b { font-size: 14px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .usuario small { color: var(--gold); font-size: 11px; }
  .avatar { display: grid; place-items: center; width: 34px; height: 34px; flex: none; border-radius: 50%; background: var(--gold-08); border: 1px solid var(--gold-60); color: var(--gold); font-weight: 600; }

  .mes-main { min-width: 0; padding: 24px clamp(16px, 3vw, 40px) 64px; }
  .mes-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid var(--cream-08); }
  .mes-top .mono.gold { font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase; }
  .mes-top h1 { font-size: clamp(26px, 3vw, 34px); font-weight: 500; letter-spacing: -1px; line-height: 1.1; margin-top: 4px; }
  .top-estado { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; color: var(--cream-70); font-size: 12px; font-variant-numeric: tabular-nums; }
  .en-vivo { display: inline-flex; align-items: center; gap: 8px; color: var(--green); }
  .en-vivo .pulse[data-off] { background: var(--orange); }
  .aviso { position: sticky; top: calc(var(--nav-offset, 0px) + 8px); z-index: 5; margin-bottom: 16px; padding: 10px 14px; border: 1px solid var(--gold-60); border-radius: var(--radius); background: var(--carbon); color: var(--cream); font-size: 13px; box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.5); }
  .aviso[hidden] { display: none; }
  .aviso[data-error] { border-color: var(--orange); color: var(--orange); }
  .mes-cont { display: grid; gap: 20px; min-width: 0; }

  /* ---------- tarjetas, KPIs, tablas ---------- */
  .m-card { display: grid; gap: 14px; align-content: start; padding: 18px; border: 1px solid var(--cream-12); border-radius: var(--radius-frame); background: var(--carbon); min-width: 0; }
  .m-card-t { color: var(--granite); font-size: 11px; font-weight: 400; letter-spacing: 0.8px; text-transform: uppercase; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1px; border: 1px solid var(--cream-12); border-radius: var(--radius-frame); background: var(--cream-12); overflow: hidden; }
  .kpi { display: grid; gap: 4px; align-content: start; padding: 16px 18px; background: var(--carbon); }
  .kpi > .mono { color: var(--granite); font-size: 11px; letter-spacing: 0.6px; text-transform: uppercase; }
  .kpi b { font-size: 28px; font-weight: 500; letter-spacing: -1px; font-variant-numeric: tabular-nums; line-height: 1.15; }
  .kpi small { color: var(--granite); font-size: 12px; }
  .kpis.grandes .kpi b { font-size: 32px; }
  .k-marcha b { color: var(--est-marcha); }
  .k-falla b { color: var(--est-falla); }
  .k-cambio b { color: var(--gold); }
  .k-oee { background: linear-gradient(160deg, var(--gold-08), var(--carbon) 70%); }
  .k-oee b { color: var(--gold); }
  .dos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 20px; }
  .barra { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 20px; }
  .barra .campo { width: min(100%, 240px); }
  .barra .campo.ancho { width: min(100%, 360px); }
  .barra-kpi { color: var(--cream-70); font-size: 12px; }
  .m-tabla { overflow-x: auto; border: 1px solid var(--cream-12); border-radius: var(--radius-frame); background: var(--carbon); }
  .m-tabla table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .m-tabla th { padding: 10px 12px; text-align: left; font-family: var(--mono); font-size: 10px; font-weight: 400; letter-spacing: 0.6px; text-transform: uppercase; color: var(--granite); background: var(--carbon); border-bottom: 1px solid var(--cream-12); white-space: nowrap; }
  .m-tabla td { padding: 9px 12px; border-bottom: 1px solid var(--cream-08); vertical-align: middle; font-variant-numeric: tabular-nums; }
  .m-tabla tr:last-child td { border-bottom: 0; }
  .m-tabla tr.clic { cursor: pointer; }
  .m-tabla tr.clic:hover td { background: var(--cream-08); }
  .m-tabla td.acc { text-align: right; white-space: nowrap; }
  .m-tabla td.acc > * + * { margin-left: 6px; }
  .m-tabla td[data-k='tira'] { min-width: 180px; }
  .m-tabla input, .m-tabla select { min-height: 32px; padding: 4px 8px; font-size: 13px; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; }
  .lista > li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding: 12px 0; border-bottom: 1px solid var(--cream-08); }
  .lista > li:last-child { border-bottom: 0; }
  .lista .sub { margin-top: 3px; }
  .btns { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .feed { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 13px; }
  .feed li { display: grid; grid-template-columns: 48px 1fr; gap: 10px; }
  .feed .mono { color: var(--granite); }
  .leyenda { display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--cream-70); font-size: 11px; align-items: center; }
  .leyenda > span { display: inline-flex; align-items: center; gap: 6px; }
  .leyenda i { width: 10px; height: 10px; border-radius: 2px; background: var(--c); }
  .leyenda .leyenda-n { color: var(--granite); margin-left: auto; }

  /* ---------- tira de estados ---------- */
  .tira { position: relative; height: 6px; border-radius: 2px; background: var(--cream-08); overflow: hidden; }
  .tira.grande { height: 12px; }
  .tira i { position: absolute; top: 0; bottom: 0; background: var(--c); }

  /* ---------- planta en vivo ---------- */
  .linea { display: grid; gap: 12px; padding-top: 8px; }
  .linea + .linea { margin-top: 12px; }
  .linea header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; }
  .linea h3 { font-size: 18px; font-weight: 500; letter-spacing: -0.4px; }
  .linea header .mono { color: var(--granite); font-size: 11px; }
  .maqs { display: grid; grid-template-columns: repeat(auto-fill, minmax(196px, 1fr)); gap: 10px; }
  .maq {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 14px 14px 12px;
    border: 1px solid var(--cream-12);
    border-radius: var(--radius-frame);
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 9%, var(--carbon)), var(--carbon) 60%);
    color: var(--cream);
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 150ms var(--ease-switch), transform 200ms var(--ease-out-expo);
  }
  .maq::before { content: ''; position: absolute; inset: 0 0 auto; height: 3px; background: var(--c); }
  .maq:hover { border-color: color-mix(in srgb, var(--c) 60%, transparent); transform: translateY(-2px); }
  .maq:focus-visible { outline: 1px solid var(--gold); }
  .maq.e-falla { border-color: color-mix(in srgb, var(--c) 55%, transparent); animation: mes-alarma 2.4s ease-in-out infinite; }
  .maq-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .maq-top > .mono { color: var(--gold); font-size: 12px; }
  .maq-n { font-size: 14px; font-weight: 500; line-height: 1.3; }
  .maq-c { color: var(--granite); font-size: 12px; min-height: 1.3em; }
  .maq-t { font-size: 20px; letter-spacing: -0.5px; color: var(--c); font-variant-numeric: tabular-nums; }

  /* ---------- mi turno ---------- */
  .turno-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 20px; align-items: start; }
  .turno-col { display: grid; gap: 20px; min-width: 0; }
  .mi-maq { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 16px; border-radius: var(--radius-frame); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); background: color-mix(in srgb, var(--c) 10%, var(--carbon)); }
  .mi-maq > div { display: grid; gap: 2px; }
  .mi-maq .mono { color: var(--granite); font-size: 11px; }
  .mi-maq b { font-size: 26px; font-weight: 500; letter-spacing: -0.8px; color: var(--c); }
  .mi-maq .mi-maq-t { font-size: 26px; color: var(--c); font-variant-numeric: tabular-nums; }
  .acciones { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
  .accion { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 10px 14px; border: 1px solid var(--cream-12); border-radius: var(--radius-frame); background: var(--black); color: var(--cream); font: inherit; font-size: 14px; text-align: left; cursor: pointer; transition: border-color 150ms var(--ease-switch), background-color 150ms var(--ease-switch); }
  .accion i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); flex: none; }
  .accion:hover:not(:disabled) { border-color: var(--c, var(--gold)); background: color-mix(in srgb, var(--c, var(--gold)) 10%, var(--black)); }
  .accion:disabled { opacity: 0.4; cursor: default; }
  .accion.otra { justify-content: center; color: var(--cream-70); }
  .turno-info { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; }
  .turno-info b { font-size: 24px; font-weight: 500; }
  .turno-info .mono { color: var(--cream-70); font-size: 12px; }

  /* ---------- órdenes ---------- */
  .prog { position: relative; display: grid; gap: 4px; margin-top: 6px; }
  .prog::before { content: ''; height: 4px; border-radius: 2px; background: var(--cream-08); grid-area: 1 / 1; }
  .prog i { height: 4px; border-radius: 2px; background: var(--gold); grid-area: 1 / 1; }
  .prog .mono { color: var(--granite); font-size: 11px; }
