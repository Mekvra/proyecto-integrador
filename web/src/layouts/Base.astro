---
import { Font } from 'astro:assets';
import '../styles/global.css';
import sitio from '../data/sitio.json';

interface Props {
  title?: string;
}

const { title = `${sitio.nombre} · Transformación Digital Industrial` } = Astro.props;
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={sitio.descripcion} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={sitio.descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <Font cssVariable="--font-switzer" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-display" preload />
    <title>{title}</title>
    <script is:inline>
      // Activa las animaciones de entrada antes del primer pintado (así no hay parpadeo).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
        // Si algo falla, el contenido se muestra igual a los 4 s.
        setTimeout(() => {
          if (!document.documentElement.classList.contains('reveal-on')) {
            document.documentElement.classList.remove('reveal-ready');
          }
        }, 4000);
      }
    </script>
  </head>
  <body id="top">
    <slot />
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
