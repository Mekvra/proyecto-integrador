---
import { Font } from 'astro:assets';
import '../styles/global.css';
import sitio from '../data/sitio.json';

interface Props {
  title?: string;
}

const { title = `${sitio.nombre} · Transformación Digital Industrial para la industria láctea` } = Astro.props;
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={sitio.descripcion} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={sitio.descripcion} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <Font cssVariable="--font-switzer" preload />
    <Font cssVariable="--font-geist-mono" />
    <title>{title}</title>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
