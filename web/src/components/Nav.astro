---
import Lockup from './Lockup.astro';
import sitio from '../data/sitio.json';
import { PAGINAS, url } from '../lib/paginas';

interface Props {
  actual?: string;
}
const { actual = 'inicio' } = Astro.props;
// Cada sección es una página: el menú lleva a su dirección y marca la página actual.
const links = PAGINAS.map((p) => ({ href: url(p.slug), label: p.label, actual: p.slug === actual }));
---

<header class="nav" data-nav>
  <span class="progreso" aria-hidden="true"></span>
  <div class="nav-inner">
    <a class="nav-home" href={url('inicio')} aria-label="Inicio"><Lockup badge={false} /></a>
    <nav aria-label="Secciones">
      <ul>
        {
          links.filter((l) => l.label !== 'Inicio').map((l) => (
            <li>
              <a href={l.href} aria-current={l.actual ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="tema-btn" type="button" data-tema aria-label="Cambiar a tema claro" title="Cambiar tema">
      <svg class="ico-sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
      <svg class="ico-luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
    </button>
    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Abrir menú"
      data-menu-btn
    >
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav aria-label="Secciones del menú">
      <ol>
        {
          links.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href} data-menu-link aria-current={l.actual ? 'page' : undefined}>
                <span class="menu-label">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <a
      class="ghost-link menu-repo"
      style={`--i:${links.length}`}
      href={sitio.repositorio}
      target="_blank"
      rel="noopener"
    >
      Repositorio en GitHub <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</header>

<style>
  /* Barra estilo X: se esconde al bajar y reaparece al subir. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--black);
    border-bottom: 1px solid transparent;
    transition:
      transform 320ms var(--ease-out-expo),
      border-color 200ms var(--ease-switch);
  }

  /* Progreso de lectura: línea dorada que crece con el scroll (navegadores con scroll-timeline). */
  .progreso {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, var(--gold-60), var(--gold));
    transform-origin: left;
    transform: scaleX(0);
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    .progreso {
      animation: progreso linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progreso {
    to {
      transform: scaleX(1);
    }
  }

  /* Solo lleva transform cuando está escondida: así el panel fijo del menú
     (que vive dentro de la barra) se posiciona respecto a la pantalla. */
  .nav[data-hidden] {
    transform: translateY(-100%);
  }

  .nav[data-scrolled],
  .nav[data-open] {
    border-bottom-color: var(--cream-08);
  }

  .nav-inner {
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin: 0 auto;
    min-height: 60px;
    padding: 8px var(--gutter);
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 14px;
    color: var(--cream-70);
    transition: color 150ms var(--ease-switch);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--cream);
  }

  /* Botón de menú: únicamente las dos rayitas. */
  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    margin-right: -10px;
    padding: 0;
    background: transparent;
    color: var(--cream);
    border: 0;
    cursor: pointer;
  }

  .menu-icon {
    position: relative;
    width: 22px;
    height: 10px;
  }

  .menu-icon i {
    position: absolute;
    left: 0;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 250ms var(--ease-out-expo),
      top 250ms var(--ease-out-expo),
      background-color 150ms var(--ease-switch);
  }

  .menu-icon i:first-child {
    top: 0;
  }

  .menu-icon i:last-child {
    top: 8.5px;
  }

  .menu-btn:hover .menu-icon i {
    background: var(--gold);
  }

  .menu-btn[aria-expanded='true'] .menu-icon i:first-child {
    top: 4.25px;
    transform: rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .menu-icon i:last-child {
    top: 4.25px;
    transform: rotate(-45deg);
  }

  /* Panel del menú */
  .menu {
    position: fixed;
    inset: var(--menu-top, 61px) 0 0 0;
    background: var(--black);
    padding: 8px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu nav {
    flex: none;
    display: block;
  }

  .menu ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .menu li,
  .menu-repo {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(4px);
  }

  .menu[data-visible] li,
  .menu[data-visible] .menu-repo {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 600ms var(--ease-out-expo),
      transform 700ms var(--ease-out-expo),
      filter 500ms var(--ease-out-expo);
    transition-delay: calc(var(--i) * 45ms);
  }

  .menu a[data-menu-link] {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--cream-08);
    color: var(--cream-70);
  }

  .menu-label {
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: -0.2px;
    transition: color 150ms var(--ease-switch);
  }

  .menu a[aria-current='page'] .menu-label,
  .menu a:hover .menu-label {
    color: var(--gold);
  }

  .menu-repo {
    font-size: 14px;
  }

  /* Botón de tema: sol en el tema oscuro (pasa a claro), luna en el claro. */
  .tema-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cream-70);
    cursor: pointer;
    transition: color 150ms var(--ease-switch);
  }

  .tema-btn:hover {
    color: var(--gold);
  }

  .tema-btn svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .ico-luna {
    display: none;
  }

  :global(:root[data-theme='light']) .ico-sol {
    display: none;
  }

  :global(:root[data-theme='light']) .ico-luna {
    display: block;
  }

  /* PC ancho: todas las secciones a la vista en la barra. Más angosto: menú de dos rayitas. */
  .nav-inner > nav ul {
    gap: 20px;
  }

  .nav-inner > nav a {
    font-size: 13px;
    white-space: nowrap;
  }

  .nav-inner > nav a[aria-current='page'] {
    color: var(--gold);
  }

  @media (max-width: 1139px) {
    .nav-inner > nav {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
      margin-left: 0;
    }
    .tema-btn {
      margin-left: auto;
      margin-right: 0;
    }
  }

  @media (min-width: 1140px) {
    .menu-btn {
      display: none;
    }
  }

  /* En PC el menú es un desplegable bajo el botón: lista vertical como en el celular, sin tapar la página. */
  @media (min-width: 961px) {
    .menu {
      inset: var(--menu-top, 61px) auto auto auto;
      right: max(var(--gutter), calc((100vw - var(--page)) / 2));
      width: 300px;
      max-height: calc(100vh - var(--menu-top, 61px) - 24px);
      padding: 8px 24px 20px;
      gap: 16px;
      border: 1px solid var(--cream-12);
      border-top: 0;
      border-radius: 0 0 var(--radius-frame) var(--radius-frame);
      transform-origin: top;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 380ms var(--ease-out-expo);
    }

    .menu[data-visible] {
      clip-path: inset(0 0 -1px 0);
    }

    .menu a[data-menu-link] {
      padding: 12px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
    .menu li,
    .menu-repo {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const root = document.documentElement;

  // --- Barra que se esconde al bajar y aparece al subir (como en X) ---
  const THRESHOLD = 8; // px de movimiento antes de reaccionar (evita parpadeos)
  let lastY = window.scrollY;
  let ticking = false;

  function setHidden(hidden: boolean) {
    if (nav.hasAttribute('data-hidden') === hidden) return;
    nav.toggleAttribute('data-hidden', hidden);
    // Las pestañas fijas de la página se acomodan debajo de la barra cuando está visible.
    root.style.setProperty('--nav-offset', hidden ? '0px' : `${nav.offsetHeight}px`);
  }

  function update() {
    ticking = false;
    const y = window.scrollY;
    nav.toggleAttribute('data-scrolled', y > 8);
    if (nav.hasAttribute('data-open') || y < nav.offsetHeight) {
      setHidden(false);
      lastY = y;
      return;
    }
    const delta = y - lastY;
    if (Math.abs(delta) < THRESHOLD) return;
    setHidden(delta > 0);
    lastY = y;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  // Si alguien navega con teclado, la barra aparece al recibir el foco.
  nav.addEventListener('focusin', () => setHidden(false));
  root.style.setProperty('--nav-offset', `${nav.offsetHeight}px`);
  update();

  // --- Tema claro / oscuro ---
  const tema = nav.querySelector<HTMLButtonElement>('[data-tema]')!;
  function pintarTema() {
    const claro = root.dataset.theme === 'light';
    tema.setAttribute('aria-label', claro ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', claro ? '#f6f3ec' : '#000000');
  }
  tema.addEventListener('click', () => {
    const claro = root.dataset.theme !== 'light';
    if (claro) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try { localStorage.setItem('tema', claro ? 'light' : 'dark'); } catch (e) {}
    pintarTema();
    window.dispatchEvent(new CustomEvent('tema'));
  });
  pintarTema();

  // --- Menú (dos rayitas, en pantallas angostas) ---
  const btn = nav.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = nav.querySelector<HTMLElement>('[data-menu]')!;
  const escritorio = window.matchMedia('(min-width: 961px)');

  function setOpen(open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    nav.toggleAttribute('data-open', open);
    document.body.style.overflow = open && !escritorio.matches ? 'hidden' : '';
    if (open) {
      menu.style.setProperty('--menu-top', `${Math.max(0, nav.getBoundingClientRect().bottom)}px`);
      menu.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => menu.setAttribute('data-visible', '')));
      if (!escritorio.matches) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    } else {
      menu.removeAttribute('data-visible');
      menu.hidden = true;
    }
  }

  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (e) => {
    if (btn.getAttribute('aria-expanded') === 'true' && !nav.contains(e.target as Node)) setOpen(false);
  });
  window.addEventListener('scroll', () => {
    if (escritorio.matches && btn.getAttribute('aria-expanded') === 'true') setOpen(false);
  }, { passive: true });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });

</script>
