---
import Lockup from './Lockup.astro';
import sitio from '../data/sitio.json';

const links = [
  { href: '#empresa', label: 'Empresa' },
  { href: '#automatizacion', label: 'Automatización' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#arquitectura', label: 'Arquitectura' },
  { href: '#simulacion', label: 'Simulación' },
  { href: '#planeacion', label: 'Planeación' },
  { href: '#modulos', label: 'Módulos' },
  { href: '#equipo', label: 'Equipo' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <Lockup badge={false} />
    <nav aria-label="Secciones">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-navlink>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="ghost-link repo" href={sitio.repositorio} target="_blank" rel="noopener">
      Repositorio <span class="arrow" aria-hidden="true">→</span>
    </a>
    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Abrir menú"
      data-menu-btn
    >
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav aria-label="Secciones del menú">
      <ol>
        {
          links.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href} data-navlink data-menu-link>
                <span class="menu-label">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <a
      class="ghost-link menu-repo"
      style={`--i:${links.length}`}
      href={sitio.repositorio}
      target="_blank"
      rel="noopener"
    >
      Repositorio en GitHub <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</header>

<style>
  /* Barra estilo X: se esconde al bajar y reaparece al subir. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--black);
    border-bottom: 1px solid transparent;
    transition:
      transform 320ms var(--ease-out-expo),
      border-color 200ms var(--ease-switch);
  }

  /* Solo lleva transform cuando está escondida: así el panel fijo del menú
     (que vive dentro de la barra) se posiciona respecto a la pantalla. */
  .nav[data-hidden] {
    transform: translateY(-100%);
  }

  .nav[data-scrolled],
  .nav[data-open] {
    border-bottom-color: var(--cream-08);
  }

  .nav-inner {
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin: 0 auto;
    min-height: 60px;
    padding: 8px var(--gutter);
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 14px;
    color: var(--cream-70);
    transition: color 150ms var(--ease-switch);
  }

  nav a:hover,
  nav a[aria-current='true'] {
    color: var(--cream);
  }

  /* Botón de menú: únicamente las dos rayitas. */
  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    margin-right: -10px;
    padding: 0;
    background: transparent;
    color: var(--cream);
    border: 0;
    cursor: pointer;
  }

  .menu-icon {
    position: relative;
    width: 22px;
    height: 10px;
  }

  .menu-icon i {
    position: absolute;
    left: 0;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 250ms var(--ease-out-expo),
      top 250ms var(--ease-out-expo),
      background-color 150ms var(--ease-switch);
  }

  .menu-icon i:first-child {
    top: 0;
  }

  .menu-icon i:last-child {
    top: 8.5px;
  }

  .menu-btn:hover .menu-icon i {
    background: var(--gold);
  }

  .menu-btn[aria-expanded='true'] .menu-icon i:first-child {
    top: 4.25px;
    transform: rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .menu-icon i:last-child {
    top: 4.25px;
    transform: rotate(-45deg);
  }

  /* Panel del menú */
  .menu {
    position: fixed;
    inset: var(--menu-top, 61px) 0 0 0;
    background: var(--black);
    padding: 8px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu nav {
    flex: none;
    display: block;
  }

  .menu ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .menu li,
  .menu-repo {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(4px);
  }

  .menu[data-visible] li,
  .menu[data-visible] .menu-repo {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 600ms var(--ease-out-expo),
      transform 700ms var(--ease-out-expo),
      filter 500ms var(--ease-out-expo);
    transition-delay: calc(var(--i) * 45ms);
  }

  .menu a[data-menu-link] {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--cream-08);
    color: var(--cream-70);
  }

  .menu-label {
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: -0.2px;
    transition: color 150ms var(--ease-switch);
  }

  .menu a[aria-current='true'] .menu-label,
  .menu a:hover .menu-label {
    color: var(--gold);
  }

  .menu-repo {
    font-size: 14px;
  }

  /* El menú de dos rayitas se usa en todos los tamaños: la barra solo lleva la marca y el botón. */
  .nav-inner > nav,
  .nav-inner > .repo {
    display: none;
  }

  .menu-btn {
    display: inline-grid;
  }

  /* En PC el menú es un desplegable bajo el botón: lista vertical como en el celular, sin tapar la página. */
  @media (min-width: 961px) {
    .menu {
      inset: var(--menu-top, 61px) auto auto auto;
      right: max(var(--gutter), calc((100vw - var(--page)) / 2));
      width: 300px;
      max-height: calc(100vh - var(--menu-top, 61px) - 24px);
      padding: 8px 24px 20px;
      gap: 16px;
      border: 1px solid var(--cream-12);
      border-top: 0;
      border-radius: 0 0 var(--radius-frame) var(--radius-frame);
      transform-origin: top;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 380ms var(--ease-out-expo);
    }

    .menu[data-visible] {
      clip-path: inset(0 0 -1px 0);
    }

    .menu a[data-menu-link] {
      padding: 12px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
    .menu li,
    .menu-repo {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const root = document.documentElement;

  // --- Barra que se esconde al bajar y aparece al subir (como en X) ---
  const THRESHOLD = 8; // px de movimiento antes de reaccionar (evita parpadeos)
  let lastY = window.scrollY;
  let ticking = false;

  function setHidden(hidden: boolean) {
    if (nav.hasAttribute('data-hidden') === hidden) return;
    nav.toggleAttribute('data-hidden', hidden);
    // Las pestañas fijas de la página se acomodan debajo de la barra cuando está visible.
    root.style.setProperty('--nav-offset', hidden ? '0px' : `${nav.offsetHeight}px`);
  }

  function update() {
    ticking = false;
    const y = window.scrollY;
    nav.toggleAttribute('data-scrolled', y > 8);
    if (nav.hasAttribute('data-open') || y < nav.offsetHeight) {
      setHidden(false);
      lastY = y;
      return;
    }
    const delta = y - lastY;
    if (Math.abs(delta) < THRESHOLD) return;
    setHidden(delta > 0);
    lastY = y;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  // Si alguien navega con teclado, la barra aparece al recibir el foco.
  nav.addEventListener('focusin', () => setHidden(false));
  root.style.setProperty('--nav-offset', `${nav.offsetHeight}px`);
  update();

  // --- Menú (dos rayitas, en todos los tamaños) ---
  const btn = nav.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = nav.querySelector<HTMLElement>('[data-menu]')!;
  const escritorio = window.matchMedia('(min-width: 961px)');

  function setOpen(open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    nav.toggleAttribute('data-open', open);
    document.body.style.overflow = open && !escritorio.matches ? 'hidden' : '';
    if (open) {
      menu.style.setProperty('--menu-top', `${Math.max(0, nav.getBoundingClientRect().bottom)}px`);
      menu.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => menu.setAttribute('data-visible', '')));
      if (!escritorio.matches) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    } else {
      menu.removeAttribute('data-visible');
      menu.hidden = true;
    }
  }

  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (e) => {
    if (btn.getAttribute('aria-expanded') === 'true' && !nav.contains(e.target as Node)) setOpen(false);
  });
  window.addEventListener('scroll', () => {
    if (escritorio.matches && btn.getAttribute('aria-expanded') === 'true') setOpen(false);
  }, { passive: true });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });

</script>
