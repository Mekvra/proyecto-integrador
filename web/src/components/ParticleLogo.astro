---
// Logo vivo de Mekvra: cientos de teselas que se ensamblan en el monograma
// y se transforman en engranaje, brazo robot, pirámide ISA-95 y gota de leche.
---

<figure class="plogo" data-plogo>
  <canvas aria-hidden="true"></canvas>
  <figcaption class="plogo-caption mono" aria-live="polite">
    <span data-index>01</span>
    <span class="plogo-rule" aria-hidden="true"></span>
    <span data-label>Mekvra</span>
  </figcaption>
</figure>

<style>
  .plogo {
    margin: 0 auto;
    width: min(420px, 72vw);
    display: grid;
    gap: 20px;
    justify-items: center;
  }

  canvas {
    width: 100%;
    aspect-ratio: 1;
    touch-action: pan-y;
  }

  .plogo-caption {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--cream-70);
    min-height: 14px;
  }

  [data-index] {
    color: var(--gold);
  }

  .plogo-rule {
    width: 24px;
    height: 1px;
    background: var(--cream-40);
  }

  [data-label] {
    transition: opacity 300ms var(--ease-switch);
  }
</style>

<script>
  import { SHAPES, SIZE, samplePoints, shuffle } from '../scripts/shapes';

  const GOLD = '200, 173, 134';
  const HOLD_MS = 3200;
  const REPEL_RADIUS = 30; // en unidades del lienzo de 200

  const easeOutExpo = (t: number) => (t >= 1 ? 1 : 1 - Math.pow(2, -10 * t));

  interface Particle {
    x: number;
    y: number;
    sx: number;
    sy: number;
    tx: number;
    ty: number;
    delay: number;
    dur: number;
    alpha: number;
    bumpX: number;
    bumpY: number;
    ox: number;
    oy: number;
  }

  function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const indexEl = root.querySelector<HTMLElement>('[data-index]')!;
    const labelEl = root.querySelector<HTMLElement>('[data-label]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const count = 1000;
    const step = 5;
    const targets = SHAPES.map((s) => samplePoints(s, count, step));

    let scale = 1;
    let tile = 2;
    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.width * dpr);
      scale = canvas.width / SIZE;
      tile = Math.max(1.5, step * scale * 0.62);
    }
    resize();
    new ResizeObserver(resize).observe(canvas);

    const particles: Particle[] = targets[0].map(([tx, ty]) => {
      // Empiezan dispersas como una nube vertical, al estilo de un campo de datos.
      const sx = 100 + (Math.random() - 0.5) * 220;
      const sy = 100 + (Math.random() - 0.5) * 220;
      return {
        x: sx,
        y: sy,
        sx,
        sy,
        tx,
        ty,
        delay: Math.random() * 500,
        dur: 1100 + Math.random() * 600,
        alpha: 0.55 + Math.random() * 0.45,
        bumpX: 0,
        bumpY: 0,
        ox: 0,
        oy: 0,
      };
    });

    let shapeIndex = 0;
    let phaseStart = performance.now();

    function setCaption(i: number) {
      indexEl.textContent = String(i + 1).padStart(2, '0');
      labelEl.style.opacity = '0';
      window.setTimeout(() => {
        labelEl.textContent = SHAPES[i].label;
        labelEl.style.opacity = '1';
      }, 200);
    }

    function morphTo(i: number, now: number) {
      shapeIndex = i;
      phaseStart = now;
      const order = shuffle([...Array(particles.length).keys()]);
      particles.forEach((p, k) => {
        const [tx, ty] = targets[i][order[k]];
        p.sx = p.x;
        p.sy = p.y;
        p.tx = tx;
        p.ty = ty;
        const dist = Math.hypot(tx - p.x, ty - p.y);
        p.delay = Math.random() * 280 + dist * 1.2;
        p.dur = 900 + Math.random() * 500;
        // Desvío en forma de nube a mitad de camino.
        const a = Math.random() * Math.PI * 2;
        const amp = 10 + Math.random() * 26;
        p.bumpX = Math.cos(a) * amp;
        p.bumpY = Math.sin(a) * amp;
      });
      setCaption(i);
    }

    // Puntero en coordenadas del lienzo de 200.
    let px = -999;
    let py = -999;
    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      px = ((e.clientX - r.left) / r.width) * SIZE;
      py = ((e.clientY - r.top) / r.height) * SIZE;
    });
    canvas.addEventListener('pointerleave', () => {
      px = -999;
      py = -999;
    });

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const p of particles) {
        ctx.fillStyle = `rgba(${GOLD}, ${p.alpha})`;
        const x = (p.x + p.ox) * scale - tile / 2;
        const y = (p.y + p.oy) * scale - tile / 2;
        ctx.fillRect(x, y, tile, tile);
      }
    }

    if (reduced) {
      particles.forEach((p) => {
        p.x = p.tx;
        p.y = p.ty;
      });
      draw();
      return;
    }

    let running = false;
    let raf = 0;
    let pausedAt = 0;

    function frame(now: number) {
      const elapsed = now - phaseStart;
      let settled = true;

      for (const p of particles) {
        const t = Math.min(1, Math.max(0, (elapsed - p.delay) / p.dur));
        if (t < 1) settled = false;
        const e = easeOutExpo(t);
        const bump = Math.sin(Math.PI * t);
        p.x = p.sx + (p.tx - p.sx) * e + p.bumpX * bump;
        p.y = p.sy + (p.ty - p.sy) * e + p.bumpY * bump;

        // Repulsión del cursor con retorno suave.
        let gx = 0;
        let gy = 0;
        const dx = p.x - px;
        const dy = p.y - py;
        const d = Math.hypot(dx, dy);
        if (d < REPEL_RADIUS && d > 0.001) {
          const f = (REPEL_RADIUS - d) / REPEL_RADIUS;
          gx = (dx / d) * f * 14;
          gy = (dy / d) * f * 14;
        }
        p.ox += (gx - p.ox) * 0.16;
        p.oy += (gy - p.oy) * 0.16;
      }

      draw();

      if (settled && elapsed > 2200 + HOLD_MS) {
        morphTo((shapeIndex + 1) % SHAPES.length, now);
      }
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running) return;
      running = true;
      if (pausedAt) phaseStart += performance.now() - pausedAt;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (!running) return;
      running = false;
      pausedAt = performance.now();
      cancelAnimationFrame(raf);
    }

    // Solo anima cuando se ve.
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }

  document.querySelectorAll<HTMLElement>('[data-plogo]').forEach(init);
</script>
