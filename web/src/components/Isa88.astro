---
// ISA-88 de los nueve productos: modelo físico y modelos procedimentales de la planta, y la receta maestra de cada
// referencia con su diagrama de procedimiento. Datos: src/data/isa88.json y public/isa88/*.svg, generados por
// 01_transformacion-digital/isa88/generar_isa88.py.
import isa from '../data/isa88.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/Mekvra/proyecto-integrador/blob/main/01_transformacion-digital/isa88/';
const grupos = isa.lineas.map((l) => ({ ...l, productos: isa.productos.filter((p) => p.linea === l.nombre) }));
---

<div class="isa" data-isa>
  <div class="isa-models">
    <a class="isa-model" href={`${base}isa88/modelo_fisico.svg`} target="_blank" rel="noopener">
      <span class="mono gold">Modelo físico</span>
      <span>Empresa → sitio → 5 áreas → 11 celdas → unidades</span>
      <span class="arrow" aria-hidden="true">↗</span>
    </a>
    {
      grupos.map((g) => (
        <a class="isa-model" href={`${base}isa88/${g.procedimiento}`} target="_blank" rel="noopener">
          <span class="mono gold">Modelo procedimental</span>
          <span>Línea de {g.nombre.charAt(0).toLowerCase() + g.nombre.slice(1)}</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>

  <div class="isa-picker" role="tablist" aria-label="Recetas maestras">
    {
      grupos.map((g) => (
        <div class="isa-group">
          <span class="mono isa-group-name">{g.nombre}</span>
          <div class="isa-group-btns">
            {g.productos.map((p) => (
              <button
                type="button"
                role="tab"
                class="isa-btn"
                id={`isa-tab-${p.codigo}`}
                aria-controls={`isa-${p.codigo}`}
                aria-selected={p.codigo === 'YF' ? 'true' : 'false'}
                tabindex={p.codigo === 'YF' ? 0 : -1}
                data-isa-tab
              >
                <span class="mono">{p.codigo}</span>
                <span>{p.nombre}</span>
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  {
    isa.productos.map((p) => (
      <section class="isa-panel" id={`isa-${p.codigo}`} role="tabpanel" aria-labelledby={`isa-tab-${p.codigo}`} hidden={p.codigo !== 'YF'}>
        <div class="isa-info">
          <div class="isa-head">
            <span class="mono gold">Receta maestra {p.codigo} · celda {p.celda}</span>
            <h3>{p.nombre}</h3>
            <p>{p.denominacion}</p>
          </div>

          <dl class="isa-facts">
            <div><dt class="mono">Lote</dt><dd>10.000 L · {p.lotes} por semana</dd></div>
            <div><dt class="mono">Orden</dt><dd>{p.orden}</dd></div>
            <div><dt class="mono">Leche base</dt><dd>{p.silo} · {p.grasa}</dd></div>
            <div><dt class="mono">Producto</dt><dd>{p.producto}</dd></div>
            <div><dt class="mono">Vida útil</dt><dd>{p.vida}</dd></div>
          </dl>

          <div class="isa-block">
            <h4 class="mono">Fórmula por lote</h4>
            <table>
              <tbody>
                {p.formula.map((f) => (
                  <tr><td>{f.insumo}</td><td>{f.cantidad}</td></tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="isa-block">
            <h4 class="mono">Puntos críticos de control</h4>
            <ul class="isa-pcc">
              {p.pcc.map((c) => (
                <li><span class="mono">{c.codigo}</span>{c.texto}</li>
              ))}
            </ul>
          </div>

          <div class="isa-block">
            <h4 class="mono">Especificación</h4>
            <ul class="isa-spec">
              {p.espec.map((e) => <li>{e}</li>)}
            </ul>
          </div>

          <a class="ghost-link" href={`${repo}recetas-maestras/${p.codigo}.md`} target="_blank" rel="noopener">
            Receta completa con fases <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <figure class="isa-chart">
          <a href={`${base}isa88/${p.diagrama}`} target="_blank" rel="noopener" aria-label={`Abrir el diagrama de procedimiento de ${p.nombre}`}>
            <img src={`${base}isa88/${p.diagrama}`} alt={`Diagrama de procedimiento ISA-88 de ${p.nombre}: ${p.up.map((u) => `${u.codigo} ${u.nombre}`).join(', ')}`} loading="lazy" />
          </a>
          <figcaption class="mono">Diagrama de procedimiento · {p.up.length} procedimientos de unidad · toca para ampliar</figcaption>
        </figure>
      </section>
    ))
  }
</div>

<style>
  .isa-models {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }

  .isa-model {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 16px 40px 16px 18px;
    border: 1px solid var(--cream-12);
    border-radius: var(--radius);
    background: var(--carbon);
    color: var(--cream);
    text-decoration: none;
    font-size: 14px;
    transition: border-color 150ms var(--ease-switch);
  }

  .isa-model:hover {
    border-color: var(--gold-60);
  }

  .isa-model .mono {
    font-size: 11px;
  }

  .isa-model .arrow {
    position: absolute;
    right: 16px;
    top: 16px;
    color: var(--gold);
  }

  .isa-picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .isa-group {
    display: grid;
    gap: 8px;
  }

  .isa-group-name {
    color: var(--granite);
    font-size: 11px;
  }

  .isa-group-btns {
    display: grid;
    gap: 6px;
  }

  .isa-btn {
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--cream-12);
    border-radius: var(--radius);
    background: transparent;
    color: var(--cream-70);
    font: inherit;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
    transition: border-color 150ms var(--ease-switch), color 150ms var(--ease-switch), background 150ms var(--ease-switch);
  }

  .isa-btn .mono {
    color: var(--gold);
    font-size: 12px;
  }

  .isa-btn:hover {
    border-color: var(--gold-60);
    color: var(--cream);
  }

  .isa-btn[aria-selected='true'] {
    border-color: var(--gold);
    background: var(--carbon);
    color: var(--cream);
  }

  .isa-panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--stroke);
  }

  .isa-panel[hidden] {
    display: none;
  }

  .isa-info {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .isa-head {
    display: grid;
    gap: 8px;
  }

  .isa-head .mono {
    font-size: 11px;
  }

  .isa-head h3 {
    margin: 0;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.6px;
  }

  .isa-head p {
    margin: 0;
    color: var(--cream-70);
    font-size: 14px;
    line-height: 1.5;
  }

  .isa-facts {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--stroke);
  }

  .isa-facts > div,
  .isa-block tr {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--stroke);
    font-size: 13px;
  }

  .isa-facts dt {
    color: var(--granite);
    font-size: 11px;
    white-space: nowrap;
  }

  .isa-facts dd {
    margin: 0;
    text-align: right;
  }

  .isa-block {
    display: grid;
    gap: 8px;
  }

  .isa-block h4 {
    margin: 0;
    color: var(--gold);
    font-size: 11px;
    font-weight: 500;
  }

  .isa-block table {
    width: 100%;
    border-collapse: collapse;
  }

  .isa-block tbody {
    display: grid;
    border-top: 1px solid var(--stroke);
  }

  .isa-block td {
    padding: 0;
    color: var(--cream-70);
  }

  .isa-block td:last-child {
    color: var(--cream);
    text-align: right;
    white-space: nowrap;
  }

  .isa-pcc,
  .isa-spec {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--cream-70);
  }

  .isa-pcc li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 8px;
  }

  .isa-pcc .mono {
    color: var(--orange);
    font-size: 11px;
    padding-top: 2px;
  }

  .isa-spec li::before {
    content: '— ';
    color: var(--granite);
  }

  .isa-chart {
    margin: 0;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .isa-chart a {
    display: block;
    border: 1px solid var(--cream-12);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    transition: border-color 150ms var(--ease-switch);
  }

  .isa-chart a:hover {
    border-color: var(--gold-60);
  }

  .isa-chart img {
    display: block;
    width: 100%;
    height: auto;
  }

  .isa-chart figcaption {
    color: var(--granite);
    font-size: 11px;
  }

  @media (max-width: 960px) {
    .isa-models {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .isa-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .isa-models,
    .isa-picker {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-isa]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-isa-tab]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(tabs[(i + d + tabs.length) % tabs.length], true);
      });
    });
  }
</script>
