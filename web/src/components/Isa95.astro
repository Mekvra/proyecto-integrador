---
import { getEntry } from 'astro:content';

const solucion = await getEntry('textos', 'solucion');
const niveles = solucion?.data.niveles ?? [];
const defecto = niveles.findIndex((n) => n.codigo === 'N4');
const activo = defecto === -1 ? 0 : defecto;
const total = niveles.length;
// Íconos de trazo fino, uno por nivel (24 × 24).
const ICONOS: Record<string, string> = {
  erp: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  mes: 'M8 4h8v3H8zM6 5.5H5v15h14v-15h-1M8.5 12h7M8.5 16h5',
  scada: 'M3 5h18v11H3zM9 20h6M12 16v4M6 13l3-3 3 2 5-5',
  plc: 'M5 4h14v16H5zM9 8h6M9 12h6M9 16h2M2 9h3M2 14h3M19 9h3M19 14h3',
  campo: 'M12 13a7 7 0 1 0-7-7M12 13l4-4M5 6H2M12 13v8M8 21h8',
  proceso: 'M7 3h10M8 3v4l-4 9a3 3 0 0 0 3 4h10a3 3 0 0 0 3-4l-4-9V3M6 13h12',
};
---

<div class="isa" data-isa>
  <div class="stack" role="tablist" aria-orientation="vertical" aria-label="Niveles ISA-95">
    <div class="rail up" aria-hidden="true">
      <span class="mono">Datos</span>
      <span class="rail-line"><i></i><i></i><i></i></span>
    </div>
    <div class="levels">
      {
        niveles.map((n, i) => (
          <button
            class="level"
            style={`--w:${Math.round(44 + (56 * i) / Math.max(1, total - 1))}%;--k:${i}`}
            role="tab"
            id={`isa-tab-${n.codigo}`}
            aria-controls={`isa-panel-${n.codigo}`}
            aria-selected={i === activo ? 'true' : 'false'}
            tabindex={i === activo ? 0 : -1}
          >
            <svg class="shape" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <polygon points="9,0 91,0 100,100 0,100" vector-effect="non-scaling-stroke" />
            </svg>
            <span class="lvl-in">
              {n.icono && (
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={ICONOS[n.icono]} />
                </svg>
              )}
              <span class="mono code">{n.codigo}</span>
              <span class="lname">{n.nombre}</span>
              {n.capa && <span class="mono capa">{n.capa}</span>}
            </span>
          </button>
        ))
      }
    </div>
    <div class="rail down" aria-hidden="true">
      <span class="mono">Órdenes</span>
      <span class="rail-line"><i></i><i></i><i></i></span>
    </div>
  </div>

  <div class="frame detail">
    <div class="frame-bar">
      <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="frame-title mono">Arquitectura ISA-95 · Mekvra</span>
    </div>
    {
      niveles.map((n, i) => (
        <section
          class="panel"
          role="tabpanel"
          id={`isa-panel-${n.codigo}`}
          aria-labelledby={`isa-tab-${n.codigo}`}
          hidden={i !== activo}
        >
          <div class="panel-top">
            <span class="mono code">{n.codigo}</span>
            <h3>{n.nombre}</h3>
            <span class="pill">{n.herramienta}</span>
          </div>
          <p class="fn">{n.funcion}</p>
          <div class="flows">
            <div>
              <span class="mono flow-label">
                <span class="arrow-up" aria-hidden="true">↑</span> Sube al nivel superior
              </span>
              {n.sube.length ? (
                <ul>
                  {n.sube.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              ) : (
                <p class="none mono">—</p>
              )}
            </div>
            <div>
              <span class="mono flow-label">
                <span aria-hidden="true">↓</span> Baja al nivel inferior
              </span>
              {n.baja.length ? (
                <ul>
                  {n.baja.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              ) : (
                <p class="none mono">—</p>
              )}
            </div>
          </div>
        </section>
      ))
    }
  </div>
</div>

<style>
  .isa {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 24px;
    align-items: stretch;
  }

  .stack {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 28px;
    gap: 12px;
  }

  /* Pirámide: el nivel más alto es el más angosto y cada nivel se ensancha hacia abajo. */
  .levels {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6px;
  }

  .level {
    position: relative;
    width: var(--w);
    min-height: 58px;
    appearance: none;
    background: transparent;
    color: var(--cream);
    font: inherit;
    border: 0;
    padding: 0 8%;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .shape polygon {
    fill: rgb(200 173 134 / calc(0.04 + var(--k) * 0.012));
    stroke: var(--cream-16);
    stroke-width: 1;
    transition:
      fill 200ms var(--ease-switch),
      stroke 150ms var(--ease-switch);
  }

  .level:hover .shape polygon {
    stroke: var(--gold-60);
  }

  .level[aria-selected='true'] .shape polygon {
    fill: var(--carbon);
    stroke: var(--gold);
  }

  .lvl-in {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px 0;
    text-align: center;
  }

  .ico {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: var(--cream-70);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 150ms var(--ease-switch);
  }

  .level[aria-selected='true'] .ico {
    stroke: var(--gold);
  }

  .code {
    color: var(--gold);
  }

  .lname {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.3px;
  }

  .capa {
    color: var(--granite);
    font-size: 11px;
  }

  .rail {
    display: grid;
    grid-template-rows: auto 1fr;
    justify-items: center;
    gap: 10px;
  }

  .rail .mono {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--granite);
    font-size: 11px;
  }

  .rail-line {
    position: relative;
    width: 1px;
    background: var(--cream-16);
    overflow: hidden;
  }

  .down .rail-line {
    background: repeating-linear-gradient(to bottom, var(--cream-40) 0 3px, transparent 3px 7px);
  }

  .rail-line i {
    position: absolute;
    left: -1.5px;
    width: 4px;
    height: 4px;
    background: var(--gold);
    animation: rise 3.6s linear infinite;
  }

  .down .rail-line i {
    background: var(--cream);
    animation-name: fall;
  }

  .rail-line i:nth-child(2) {
    animation-delay: -1.2s;
  }

  .rail-line i:nth-child(3) {
    animation-delay: -2.4s;
  }

  @keyframes rise {
    from {
      top: 100%;
    }
    to {
      top: -4px;
    }
  }

  @keyframes fall {
    from {
      top: -4px;
    }
    to {
      top: 100%;
    }
  }

  .detail {
    display: flex;
    flex-direction: column;
  }

  .panel {
    padding: 28px;
    display: grid;
    gap: 20px;
    align-content: start;
    animation: fade 150ms var(--ease-switch);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .panel-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .panel-top h3 {
    font-size: 28px;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .fn {
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.2px;
    color: var(--cream-70);
    max-width: 55ch;
  }

  .flows {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    border-top: 1px solid var(--stroke);
    padding-top: 20px;
  }

  .flow-label {
    display: block;
    color: var(--granite);
    margin-bottom: 10px;
  }

  .arrow-up {
    color: var(--gold);
  }

  .flows ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .flows li {
    font-size: 14px;
    padding-left: 14px;
    position: relative;
  }

  .flows li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 1px;
    background: var(--gold);
  }

  .none {
    color: var(--granite);
  }

  @media (max-width: 900px) {
    .isa {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .level {
      width: calc(62% + var(--k) * 7.6%);
      padding: 0 9%;
    }
    .capa {
      display: none;
    }
    .stack {
      grid-template-columns: 18px minmax(0, 1fr) 18px;
      gap: 8px;
    }
    .flows {
      grid-template-columns: 1fr;
    }
    .panel {
      padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-line i {
      animation: none;
      display: none;
    }
    .panel {
      animation: none;
    }
  }
</style>

<script>
  function init(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    function select(tab: HTMLButtonElement, focus = false) {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
      const detail = root.querySelector<HTMLElement>('.detail');
      if (detail && window.matchMedia('(max-width: 900px)').matches) {
        const r = detail.getBoundingClientRect();
        if (r.top > window.innerHeight - 120) detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        select(tabs[(i + dir + tabs.length) % tabs.length], true);
      });
    });
  }
  document.querySelectorAll<HTMLElement>('[data-isa]').forEach(init);
</script>
